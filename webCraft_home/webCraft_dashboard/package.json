{
  "name": "web-craft",
  "version": "1.0.0",
  "description": "The official WebCraft desktop dashboard for building websites.",
  "main": "main.js",
  "author": "Zabloon Biniam",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./icons/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "setupIcon": "./icons/icon.ico",
            "authors": "Zabloon Biniam" 
          }
        }
      ]
    }
  }
}